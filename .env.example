# Copy to .env.local for `vercel dev`, or set in Vercel → Settings → Environment Variables.
# Never commit real keys.

# Google Analytics 4 (optional). When unset, GA scripts no-op and no gtag is loaded.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain you verified in Resend
RESEND_FROM_EMAIL=NBBL Website <contact@thecpi.network>
# Optional: comma-separated list (defaults to helpkeepmymoney@gmail.com, marknobackboard@gmail.com)
# CONTACT_TO_EMAIL=helpkeepmymoney@gmail.com,marknobackboard@gmail.com

# Constant Contact (optional): after a successful Resend notification, sync name + email to CRM via
# POST /v3/contacts/sign_up_form. Create a V3 app, complete OAuth once to obtain a refresh token
# with scope contact_data, then add the list UUID from Constant Contact → Contacts → Lists.
# CONSTANT_CONTACT_CLIENT_ID=
# CONSTANT_CONTACT_CLIENT_SECRET=
# CONSTANT_CONTACT_REFRESH_TOKEN=
# One list: CONSTANT_CONTACT_LIST_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Or many: CONSTANT_CONTACT_LIST_IDS=id1,id2
